# =====================================================
# Paşaoğlu Group — Production environment variables
# Plesk Node.js sekmesindeki "Environment Variables"a ekle
# veya /httpdocs/.env dosyası olarak SSH ile yükle.
# =====================================================

# Node
NODE_ENV=production
PORT=3000

# Payload — uzun rastgele bir secret (openssl rand -hex 32 ile üret)
PAYLOAD_SECRET=DEGISTIR_uzun_rastgele_64_karakter_minimum

# PostgreSQL (Plesk Database sekmesinden oluşturduğun veritabanı)
# Format: postgres://kullanici:sifre@host:port/dbname
DATABASE_URI=postgres://pasaoglu_admin:SIFRE@127.0.0.1:5432/pasaoglu_web

# Site URL (DNS yayına alınca güncelle)
NEXT_PUBLIC_SERVER_URL=https://pasaoglugroup.com.tr

# Opsiyonel: Memory limiti (Plesk build OOM verirse)
# NODE_OPTIONS=--max-old-space-size=2048
